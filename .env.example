# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# ------------------------------------------------------------------
# Webhook do classificador (agente OpenBot) — sem chaves de IA paga.
# Cada tweet novo é gravado como PENDENTE e disparado por POST assinado:
# headers x-openbot-timestamp (Unix s), x-openbot-delivery-id (o HASH do
# tweet — idempotente) e x-openbot-signature (sha256= HMAC-SHA256 de
# "<timestamp>.<delivery ID>.<corpo>" com o segredo). Só 202 marca como
# processado; 401/503 re-tentam no ciclo seguinte; 400 descarta.
PROMO_WEBHOOK_URL=https://signal.openbot.run/v1/webhooks/1a7a2fc3-b3fb-4500-b7fc-54eb209a7d33
PROMO_WEBHOOK_SECRET=seu_segredo_aqui

# ------------------------------------------------------------------
# Nitter — instâncias RSS
# Lista em ordem de preferência (vírgula); o worker rotaciona
# automaticamente quando uma acumula falhas seguidas.
NITTER_INSTANCES=https://twiiit.com,https://nitter.privacydev.net,https://nitter.net,https://nitter.1d4.us
# Retrocompatível: NITTER_BASE entra como primeira instância se definido.
NITTER_BASE=
FALHAS_PARA_ROTACIONAR=2

# ------------------------------------------------------------------
# Feed do site — promos.json exportado a cada ciclo
PROMOS_JSON_PATH=site/promos.json
PROMOS_LIMITE=500

# ------------------------------------------------------------------
# Telegram — notificação feita pelo AGENTE classificador, não pelo worker.
# notifier.py fica como referência de formatação.
TELEGRAM_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# WhatsApp Cloud API (Meta Graph) — também pelo AGENTE, mesmo papel do
# Telegram. Painel da Meta: número de teste, phone number ID e token de
# system user (README, seção WhatsApp). O destinatário entra em WA_DESTINO
# com DDI+dígitos e precisa mandar um 'oi' pro número (janela de 24 h).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_DESTINO=

# Opcionais
INTERVALO_POLLING=60
DATABASE_URL=sqlite:///promocoes.db
LOG_LEVEL=INFO

# Idade máxima de ingestão em horas (default 48; 0 desliga) — o robô é de
# tempo real: tweet mais velho que isso é descartado antes de gravar.
IDADE_MAXIMA_INGESTAO_HORAS=48
