# Copie este arquivo para .env e preencha com seus valores
# cp .env.example .env

# ------------------------------------------------------------------
# Webhook do classificador (agente OpenBot) — sem chaves de IA paga.
# Cada tweet novo é gravado como PENDENTE e disparado por POST assinado
# (header X-Secret) para a URL abaixo; o agente responde gravando a
# classificação via cli.py. Sem resposta, o ciclo seguinte re-dispara.
PROMO_WEBHOOK_URL=sua_url_de_webhook_aqui
PROMO_WEBHOOK_SECRET=seu_segredo_aqui

# ------------------------------------------------------------------
# Nitter — instâncias RSS
# Lista em ordem de preferência (vírgula); o worker rotaciona
# automaticamente quando uma acumula falhas seguidas.
NITTER_INSTANCES=https://twiiit.com,https://nitter.privacydev.net,https://nitter.net,https://nitter.1d4.us
# Retrocompatível: NITTER_BASE entra como primeira instância se definido.
NITTER_BASE=
FALHAS_PARA_ROTACIONAR=2

# ------------------------------------------------------------------
# Feed do site — promos.json exportado a cada ciclo
PROMOS_JSON_PATH=site/promos.json
PROMOS_LIMITE=500

# ------------------------------------------------------------------
# Telegram — notificação feita pelo AGENTE classificador, não pelo worker.
# notifier.py fica como referência de formatação.
TELEGRAM_TOKEN=seu_token_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Opcionais
INTERVALO_POLLING=60
DATABASE_URL=sqlite:///promocoes.db
LOG_LEVEL=INFO
